+
+#[test]
+fn wide_image_atomic_minmax_orders_whole_values() {
+    // The first operand is larger as u64 and smaller as i64. Its low word
+    // is smaller than the second's, so comparing dwords independently fails.
+    let first = [2, 0x8000_0000];
+    let second = [0xFFFF_FFFE, 0x7FFF_FFFF];
+    for (op, name, expected) in [
+        (0x014, "smin", first),
+        (0x015, "umin", second),
+        (0x016, "smax", second),
+        (0x017, "umax", first),
+    ] {
+        let shader = build_atomic_cs_with_second(
+            image_atomic(0x00F, 2, 0, 8, 3, false),
+            image_atomic(op, 8, 0, 8, 3, true),
+            8,
+            Some(second),
+        );
+        run_atomic_cases(&shader, &[[1, 0, first[0], first[1]]], |backend, _, _, texels, old| {
+            assert_eq!(&texels[2..4], &expected, "{backend}: {name} final texel");
+            assert_eq!(old, &first, "{backend}: {name} previous texel");
+            println!("{backend}: {name} old={old:08x?} result={expected:08x?}");
+        });
+    }
+}
