+#[test]
+fn wave64_host32_reads_logical_lane_32() {
+    let host = Host::new(false).expect("D3D12 hardware adapter");
+    super::set_host_wave32(true);
+    let lowered = build_for_group(&[
+        0xBE84_0300, // s_mov_b32 s4, s0
+        0xBE85_0380, // s_mov_b32 s5, 0
+        0xF408_0A02,
+        0xFA00_0040, // s_load_dwordx4 s[40:43], s[4:5], 0x40
+        0x7E02_02FF,
+        0x0000_0080, // v_mov_b32 v1, 32 * sizeof(u32)
+        0x4A04_00FF,
+        0x0000_03E8, // v_add_nc_u32 v2, 1000, v0
+        0x3420_0082, // v_lshlrev_b32 v16, 2, v0
+        0xBF8C_C07F, // s_waitcnt lgkmcnt(0)
+        0xDACC_0000,
+        0x0300_0201, // ds_bpermute_b32 v3, v1, v2
+        0xBF8C_C07F, // s_waitcnt lgkmcnt(0)
+        0xE070_1000,
+        0x800A_0310, // buffer_store_dword v3, v16, s[40:43], 0 offen
+        0xBF81_0000, // s_endpgm
+    ], true, 64);
+    super::set_host_wave32(false);
+    let mut shader = lowered.expect("lower wave64 fixture");
+    let mut validator = validator::Validator::load(validator::Validator::default_path().as_deref())
+        .expect("DXIL validator");
+    validator.validate(&mut shader.dxil).expect("valid DXIL");
+    let (root, pso) = host.compute_pipeline(&shader).expect("Wave32 PSO");
+    let ud = vec![0; shader.user_data_dwords().max(1) as usize];
+    let views = [View::Texture(1, 1, &[[0.0; 4]]), View::Buffer {
+        data: &[0; 4], stride: Stride::Structured(16),
+    }, View::RawUav(64)];
+    let output = host.dispatch(&root, &pso, &Dispatch {
+        roots: vec![(0, Root::Constants(ud))], views: &views, samplers: &[], groups: [1, 1, 1],
+    }).expect("dispatch and read back");
+    println!("logical lane 32 value=1032 output_lane_0={} output_lane_32={}", output[0][0], output[0][32]);
+    assert_eq!(output[0], vec![1032; 64], "all lanes must read the guest wave's lane 32");
 }
 
 #[test]
